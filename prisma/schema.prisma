// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
  reviews Review[]
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum ApprovalStatus {
  PENDING
  FLAGGED
  APPROVED
  REJECTED
}

model Bathroom {
  id            Int      @id @default(autoincrement())
  building      String
  floor         String
  roomNumber    String?
  type          String   @default("Multi-Stall (Men & Women)")
  stallCount    Int      @default(1)
  lastRenovated Int?
  isAccessible  Boolean  @default(false)
  amenities     String[]
  notes         String?
  reviews       Review[]
}

model Review {
  id            Int            @id @default(autoincrement())
  overallScore  Int
  cleanliness   Int
  odor          Int
  conditionTags String[]
  comment       String?
  status        ApprovalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  userId        Int
  bathroomId    Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bathroom      Bathroom       @relation(fields: [bathroomId], references: [id], onDelete: Cascade)
}